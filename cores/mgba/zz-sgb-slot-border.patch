diff --git a/src/platform/libretro/libretro.c b/src/platform/libretro/libretro.c
index f316929..15301d5 100644
--- a/src/platform/libretro/libretro.c
+++ b/src/platform/libretro/libretro.c
@@ -1219,6 +1219,62 @@ static void _updateGbPal(void) {
 }
 #endif
 
+
+#ifdef M_CORE_GB
+/* slot.: the Super Game Boy border slot. chose, read from slot_sgb_border.bin in the system
+ * directory. The option "mgba_slot_sgb_border" is "auto:N" (a game's own border wins) or
+ * "lock:N" (this border always); N changes whenever the file does, so a change in play shows. */
+static uint8_t slotSgbBorder[SGB_SIZE_CHAR_RAM + SGB_SIZE_MAP_RAM];
+static char slotSgbBorderOption[64];
+
+static void _slotSgbBorder(bool live) {
+	struct retro_variable var = {
+		.key = "mgba_slot_sgb_border",
+		.value = 0
+	};
+	if (!environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) || !var.value) {
+		return;
+	}
+	if (strcmp(var.value, slotSgbBorderOption) == 0) {
+		return;
+	}
+	snprintf(slotSgbBorderOption, sizeof(slotSgbBorderOption), "%s", var.value);
+	GBSGBBorderLocked = strncmp(var.value, "lock", 4) == 0;
+	const char* sysDir = 0;
+	char path[PATH_MAX];
+	environCallback(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &sysDir);
+	if (!sysDir) {
+		return;
+	}
+	snprintf(path, sizeof(path), "%s%s%s", sysDir, PATH_SEP, "slot_sgb_border.bin");
+	struct VFile* vf = VFileOpen(path, O_RDONLY);
+	if (!vf) {
+		GBSGBDefaultBorder = NULL;
+		return;
+	}
+	bool whole = vf->read(vf, slotSgbBorder, sizeof(slotSgbBorder)) == (ssize_t) sizeof(slotSgbBorder);
+	vf->close(vf);
+	GBSGBDefaultBorder = whole ? slotSgbBorder : NULL;
+	if (!live || !whole || !core || core->platform(core) != mPLATFORM_GB) {
+		return;
+	}
+	struct GB* gb = core->board;
+	struct GBVideoRenderer* renderer = gb->video.renderer;
+	if (!(gb->model & GB_MODEL_SGB) || !renderer->sgbCharRam || !renderer->sgbMapRam) {
+		return;
+	}
+	if (GBSGBBorderFromGame && !GBSGBBorderLocked) {
+		return;
+	}
+	memcpy(renderer->sgbCharRam, slotSgbBorder, SGB_SIZE_CHAR_RAM);
+	memcpy(renderer->sgbMapRam, &slotSgbBorder[SGB_SIZE_CHAR_RAM], SGB_SIZE_MAP_RAM);
+	if (gb->video.sgbBorders) {
+		renderer->enableSGBBorder(renderer, false);
+		renderer->enableSGBBorder(renderer, true);
+	}
+}
+#endif
