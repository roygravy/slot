diff --git a/src/platform/libretro/libretro.c b/src/platform/libretro/libretro.c
index f316929..38b104c 100644
--- a/src/platform/libretro/libretro.c
+++ b/src/platform/libretro/libretro.c
@@ -1219,6 +1219,102 @@ static void _updateGbPal(void) {
 }
 #endif
 
+
+#ifdef M_CORE_GB
+/* slot.: the Super Game Boy border slot. chose, read from slot_sgb_border.bin in the system
+ * directory. The option "mgba_slot_sgb_border" is "auto:N" (a game's own border wins) or
+ * "lock:N" (this border always); N changes whenever the file does, so a change in play shows. */
+static uint8_t slotSgbBorder[SGB_SIZE_CHAR_RAM + SGB_SIZE_MAP_RAM];
+static bool slotSgbBorderWhole = false;
+static char slotSgbBorderOption[64];
+/* Every border slot. may have put in (slot_sgb_ours.bin, one after another): a saved state that
+ * brings one of them back gives way to the border chosen now; a game's own border stays. */
+static uint8_t* slotSgbOurs = NULL;
+static size_t slotSgbOursSize = 0;
+
+static void _slotSgbBorderApply(bool restored) {
+	if (!slotSgbBorderWhole || !core || core->platform(core) != mPLATFORM_GB) {
+		return;
+	}
+	struct GB* gb = core->board;
+	struct GBVideoRenderer* renderer = gb->video.renderer;
+	if (!(gb->model & GB_MODEL_SGB) || !renderer->sgbCharRam || !renderer->sgbMapRam) {
+		return;
+	}
+	if (restored) {
+		bool ours = false;
+		size_t at;
+		for (at = 0; !ours && at + sizeof(slotSgbBorder) <= slotSgbOursSize; at += sizeof(slotSgbBorder)) {
+			ours = memcmp(renderer->sgbCharRam, &slotSgbOurs[at], SGB_SIZE_CHAR_RAM) == 0 &&
+				memcmp(renderer->sgbMapRam, &slotSgbOurs[at + SGB_SIZE_CHAR_RAM], SGB_SIZE_MAP_RAM) == 0;
+		}
+		if (!ours) {
+			/* The game's own border came back with the state: keep it for Auto. */
+			memcpy(GBSGBGameBorder, renderer->sgbCharRam, SGB_SIZE_CHAR_RAM);
+			memcpy(&GBSGBGameBorder[SGB_SIZE_CHAR_RAM], renderer->sgbMapRam, SGB_SIZE_MAP_RAM);
+			GBSGBBorderFromGame = true;
+			if (!GBSGBBorderLocked) {
+				return;
+			}
+		}
+	}
+	/* Auto with a border the game sent: the game's own, kept even while another was locked. */
+	const uint8_t* border = !GBSGBBorderLocked && GBSGBBorderFromGame ? GBSGBGameBorder : slotSgbBorder;
+	memcpy(renderer->sgbCharRam, border, SGB_SIZE_CHAR_RAM);
+	memcpy(renderer->sgbMapRam, &border[SGB_SIZE_CHAR_RAM], SGB_SIZE_MAP_RAM);
+	if (gb->video.sgbBorders) {
+		renderer->enableSGBBorder(renderer, false);
+		renderer->enableSGBBorder(renderer, true);
+	}
+}
+
+static void _slotSgbBorder(bool live) {
+	struct retro_variable var = {
+		.key = "mgba_slot_sgb_border",
+		.value = 0
+	};
+	if (!environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) || !var.value) {
+		return;
+	}
+	if (strcmp(var.value, slotSgbBorderOption) == 0) {
+		return;
+	}
+	snprintf(slotSgbBorderOption, sizeof(slotSgbBorderOption), "%s", var.value);
+	GBSGBBorderLocked = strncmp(var.value, "lock", 4) == 0;
+	const char* sysDir = 0;
+	char path[PATH_MAX];
+	environCallback(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &sysDir);
+	if (!sysDir) {
+		return;
+	}
+	snprintf(path, sizeof(path), "%s%s%s", sysDir, PATH_SEP, "slot_sgb_ours.bin");
+	struct VFile* vf = VFileOpen(path, O_RDONLY);
+	free(slotSgbOurs);
+	slotSgbOurs = NULL;
+	slotSgbOursSize = 0;
+	if (vf) {
+		ssize_t size = vf->size(vf);
+		if (size > 0 && (slotSgbOurs = malloc(size))) {
+			slotSgbOursSize = vf->read(vf, slotSgbOurs, size) == size ? (size_t) size : 0;
+		}
+		vf->close(vf);
+	}
+	snprintf(path, sizeof(path), "%s%s%s", sysDir, PATH_SEP, "slot_sgb_border.bin");
+	vf = VFileOpen(path, O_RDONLY);
+	if (!vf) {
+		slotSgbBorderWhole = false;
+		GBSGBDefaultBorder = NULL;
+		return;
+	}
+	slotSgbBorderWhole = vf->read(vf, slotSgbBorder, sizeof(slotSgbBorder)) == (ssize_t) sizeof(slotSgbBorder);
+	vf->close(vf);
+	GBSGBDefaultBorder = slotSgbBorderWhole ? slotSgbBorder : NULL;
+	if (live) {
+		_slotSgbBorderApply(false);
+	}
+}
+#endif
