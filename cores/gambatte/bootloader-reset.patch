 void Bootloader::reset() {
+   /* A reset while the boot ROM still runs: put the cartridge's own bytes
+    * back first, or the next load() backs up the boot ROM as the game and
+    * the cartridge never starts again. */
+   if (using_bootloader && !has_called_FF50 && addrspace_start)
+      std::memcpy((uint8_t*)addrspace_start, rombackup, bootloadersize);
    bootloadersize = 0;
    has_called_FF50 = false;
    addrspace_start = NULL;
